# ===== مفرّغ الوقّاد =====
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
DEEPGRAM_API_KEY=
COHERE_API_KEYS=
GEMINI_API_KEY=
# على Modal: ضع رابط نقطة ASGI بعد أول نشر (مثال):
# https://<workspace>--waqqad-transcriber-web.modal.run
BASE_URL=https://waqqad-transcriber.onrender.com
TRANSCRIBER_WEBAPP_URL=https://alwaqad-afk.github.io/waqqad-transcriber-web/
TRANSCRIBER_LOG_CHAT_ID=

# ===== Modal (المسار الأساسي) =====
# للـ CI فقط: أضف MODAL_TOKEN_ID وMODAL_TOKEN_SECRET كأسرار مستودع GitHub.
# لا تضعهما هنا ولا داخل الصورة.
# تُضبط القيم التالية داخل Modal Secret وليس في المستودع.
# WAQQAD_MODAL_MODE=1
# WAQQAD_MODAL_WORKER=1 تُضاف تلقائيًا داخل دالة العامل.
# WAQQAD_SYNC_REFINE=1 تُضاف تلقائيًا داخل دالة العامل.
# MODAL_SECRET_NAMES=waqqad-transcriber-env
# MODAL_APP_NAME=waqqad-transcriber

# ===== Render (طوارئ فقط عند فشل Modal بالكامل) =====
# لا تُرسل أي مهمة إلى Render ما دام Modal يعمل. اتركها فارغة لتعطيل
# الاحتياطي تمامًا. إن ضبطت الرابط فلا بد من نفس السر على الخدمتين.
RENDER_FALLBACK_URL=
RENDER_FALLBACK_ENABLED=1
RENDER_FALLBACK_SECRET=
RENDER_FALLBACK_TIMEOUT=180
# تُضبط على خدمة Render الاحتياطية فقط: تمنع فحص المهام المعلقة عند
# الإقلاع حتى لا تُعلَّم مهام Modal النشطة بالفشل.
# WAQQAD_RENDER_FALLBACK_MODE=1
# WAQQAD_DISABLE_MODAL_DISPATCH=1

# ===== الهوية والتواصل =====
DEVELOPER_NAME=الوقّاد
DEVELOPER_CHAT_ID=7991076455
DEVELOPER_USERNAME=
DEVELOPER_CONTACT=
CONTRIBUTORS=عدة نماذج لغوية ساعدت في التصميم والكتابة والاختبار

# ===== الاستقبال المباشر والطابور =====
TRANSCRIBER_MAX_UPLOAD_MB=20
TRANSCRIBER_QUEUE_WORKERS=2

# ===== تفريغ الروابط =====
TRANSCRIBER_URL_MAX_MB=150
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=

# ===== أسرار الويبهوك (أنشئها عشوائية) =====
TELEGRAM_WEBHOOK_SECRET=
WARRAQ_WEBHOOK_SECRET=
TELEGRAM_INITDATA_MAX_AGE=86400

# ===== المدقق =====
GEMINI_MODEL=gemini-3.5-flash-lite
REFINE_CHUNK_CHARS=3500
REFINE_MIN_CHUNK_CHARS=500
REFINE_TIMEOUT=180
REFINE_MAX_RETRIES=3
REFINE_REQUEST_GAP=1.0
REFINE_CONCURRENCY=3
REFINE_THINKING_LEVEL=minimal

# ===== الورّاق =====
WARRAQ_BOT_TOKEN=
WARRAQ_STORAGE_CHAT_ID=
